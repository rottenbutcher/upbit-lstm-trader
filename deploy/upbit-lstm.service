[Unit]
Description=Upbit LSTM five-minute decision
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=upbitbot
Group=upbitbot
WorkingDirectory=/opt/upbit-lstm/current
EnvironmentFile=/etc/upbit-lstm.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/upbit-lstm/current/.venv/bin/python -m upbit_bot.cli run --once --artifacts /opt/upbit-lstm/current/artifacts --state-dir /var/lib/upbit-lstm
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/upbit-lstm
UMask=0077
MemoryMax=1G
StandardOutput=journal
StandardError=journal
